NEAR_NETWORK_ID=testnet
NEAR_CONTRACT_ID=rewind.rewindproof-mwfi8ufi-fa888154e57d.testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
POLL_INTERVAL_MS=10000
# Railway Testnet-only account bootstrap (persistent /data volume required):
ALLOW_TESTNET_FAUCET_KEEPER=true
KEEPER_CREDENTIALS_FILE=/data/rewind-keeper.json
# Alternatively set BOTH KEEPER_ACCOUNT_ID and KEEPER_PRIVATE_KEY via secrets.
# Mainnet never bootstraps keys, requires deliberate owner approval.
# ENABLE_MAINNET_KEEPER=I_ACCEPT_MAINNET_RISK
